# ============================================================================
# PayDoc AI — Git Ignore Rules
# ============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Next.js & Frontend Build Outputs
.next/
*/.next/
out/
build/
dist/
*/dist/

# TypeScript & Cache
*.tsbuildinfo
.eslintcache
.cache/

# Environment Variables & Secrets (CRITICAL SECURITY)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local

# Allow example environment template
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary Storage & Local Uploads
tmp/
scratch/
uploads/
*/uploads/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
